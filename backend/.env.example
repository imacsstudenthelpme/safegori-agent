UPSTAGE_API_KEY=your-api-key-here
UPSTAGE_MODEL=solar-pro2

# Neo4j (프로젝트 루트의 Docker Compose)
NEO4J_URI=bolt://127.0.0.1:7688
NEO4J_USER=neo4j
NEO4J_PASSWORD=your-neo4j-password
# 기본 DB가 아니면 이름을 적으세요 (예: 기존 데이터를 남겨 두고 새 DB에 적재한 경우)
NEO4J_DATABASE=

# SIF RAG
GENERATION_API_KEY=
GENERATION_API_MODEL=solar-pro4
EMBEDDING_API_KEY=
EMBEDDING_MODEL_QUERY=solar-embedding-2-query
EMBEDDING_MODEL_PASSAGE=solar-embedding-2-passage
